#include <stdio.h>

int main() {

    int vector[5];
    int i;
    int suma = 0;
    float promedio;

    for (i = 0; i < 5; i++) {
        printf("Ingrese el dato %d: ", i + 1);
        scanf("%d", &vector[i]);
    }

    for (i = 0; i < 5; i++) {
        suma = suma + vector[i];
    }
    
    promedio = (float)suma / 5;

    printf("\nLa suma de los números es: %d\n", suma);
    printf("El promedio es: %.2f\n", promedio);

    return 0;
}
Punto 3)
#include <stdio.h>

int main() {

    int vector[5];
    int i;
    int posicion;
    char continuar;

    for (i = 0; i < 5; i++) {
        printf("Ingrese el dato %d: ", i + 1);
        scanf("%d", &vector[i]);
    }
    
    do {
        printf("\nIngrese la posicion del dato que quiere consultar (1-5): ");
        scanf("%d", &posicion);

        if (posicion >= 1 && posicion <= 5) {
            printf("El dato es: %d\n", vector[posicion - 1]);
        } else {
            printf("Posicion incorrecta.\n");
        }

        printf("\n¿Desea consultar otro dato? (si/no): ");
        scanf(" %c", &continuar);

    } while (continuar == 's' || continuar == 'S');

    printf("\nFin del programa.\n");

    return 0;
}
