#include <stdio.h>

int main() {

    int vector[5];
    int i;

    for (i = 0; i < 5; i++) {
        printf("Ingrese el dato %d: ", i + 1);
        scanf("%d", &vector[i]);
    }

    printf("\nDatos del vector:\n");

